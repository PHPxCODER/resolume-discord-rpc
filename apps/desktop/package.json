{
  "name": "@resolume-discord-rpc/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "out/src/main.js",
  "scripts": {
    "build:ts": "pnpm --filter @resolume-discord-rpc/core build && tsc",
    "start": "pnpm build:ts && electron .",
    "dev": "pnpm start",
    "generate-icons": "pnpm build:ts && node out/scripts/generate-icons.js",
    "bundle": "esbuild out/src/main.js --bundle --platform=node --format=cjs --external:electron --outfile=bundle/main.js",
    "build": "pnpm build:ts && pnpm bundle && electron-builder --publish never"
  },
  "dependencies": {
    "@resolume-discord-rpc/core": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.resolume-discord-rpc.app",
    "productName": "Resolume Discord RPC",
    "asar": true,
    "files": [
      "bundle/**/*",
      "assets/**/*",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "bundle/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icon.png",
      "category": "public.app-category.utilities"
    },
    "publish": {
      "provider": "github",
      "owner": "PHPxCODER",
      "repo": "resolume-discord-rpc"
    }
  }
}
